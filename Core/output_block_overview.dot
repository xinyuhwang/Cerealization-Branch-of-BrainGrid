//-------LAYOUT OF RELATIONSHIPS BETWEEN SUBGRAPHS------//
rankdir = BT; // Rank Direction Top to Bottom
nodesep = 0.21; // Node Separation
ranksep = 0.21; // Rank Separation
concentrate = true;


edge [color=aquamarine];
. -> Timer [arrowhead=ediamond];

edge [color=black];
BGDriver -> . [arrowhead=ediamond];

edge [color=aquamarine];
. -> IAllNeurons [arrowhead=ediamond];
